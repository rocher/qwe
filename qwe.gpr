with "config/qwe_config.gpr";
project Qwe is

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Qwe_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("qwe.adb");

   package Compiler is
      for Default_Switches ("Ada") use Qwe_Config.Ada_Compiler_Switches;
   end Compiler;

   package Linker is
      Linker_Switches := ();
      case Qwe_Config.Alire_Host_OS is
         when "linux" =>
            Linker_Switches := Linker_Switches & (
               "-Lgrammar/lib",
               "-ltree-sitter-qwe_ada",
               "-ltree-sitter"
               );
         when others =>
            null;
      end case;

      for Switches ("Ada") use Linker_Switches;
   end Linker;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Qwe;
